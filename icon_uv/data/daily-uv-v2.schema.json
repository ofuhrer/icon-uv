{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily UV forecast product v2",
  "description": "Four local dates or all forecast daylight dates. Per-entry support, rounding and missing-value rules match v1. Date offsets and pairing require semantic checks.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_sha256",
    "issued_at",
    "timezone",
    "peak_definition",
    "category_basis",
    "catalog_sha256",
    "input_sha256",
    "radiation_table_sha256",
    "sources",
    "qualification",
    "assumptions",
    "temporal_limitation",
    "entries",
    "valid_dates"
  ],
  "properties": {
    "schema_version": {
      "const": "daily-uv-v2"
    },
    "contract_sha256": {
      "const": "804568736f489e914b8c63ac99b2857154ed616a644431efbe04df36e524d422"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Europe/Zurich"
    },
    "peak_definition": {
      "const": "maximum_30min_mean_on_5min_grid_hourly_cloud_reconstruction"
    },
    "category_basis": {
      "const": "rounded_integer_half_up"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "radiation_table_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "object",
      "required": [
        "icon",
        "cams"
      ],
      "properties": {
        "icon": {
          "type": "object",
          "required": [
            "reference_time",
            "age_hours"
          ],
          "properties": {
            "reference_time": {
              "type": "string",
              "format": "date-time"
            },
            "age_hours": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "cams": {
          "type": "object",
          "required": [
            "reference_time",
            "age_hours"
          ],
          "properties": {
            "reference_time": {
              "type": "string",
              "format": "date-time"
            },
            "age_hours": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "string",
      "minLength": 1
    },
    "temporal_limitation": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "valid_dates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "date"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "location",
        "valid_date",
        "day",
        "status",
        "reasons",
        "selected_cells",
        "valid_cells",
        "uvi",
        "display_uvi",
        "category"
      ],
      "properties": {
        "location": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "altitude_m"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "town",
                "region_altitude"
              ]
            },
            "altitude_m": {
              "type": "number"
            },
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "town"
                  }
                }
              },
              "then": {
                "required": [
                  "latitude",
                  "longitude"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "region_altitude"
                  }
                }
              },
              "then": {
                "required": [
                  "bbox"
                ],
                "properties": {
                  "altitude_m": {
                    "enum": [
                      1000,
                      2000,
                      3000
                    ]
                  }
                }
              }
            }
          ]
        },
        "valid_date": {
          "type": "string",
          "format": "date"
        },
        "day": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "ok",
            "degraded",
            "unavailable"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "selected_cells": {
          "type": "integer",
          "minimum": 0
        },
        "valid_cells": {
          "type": "integer",
          "minimum": 0
        },
        "uvi": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "display_uvi": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "category": {
          "enum": [
            "low",
            "moderate",
            "high",
            "very_high",
            "extreme",
            null
          ]
        },
        "aggregation": {
          "enum": [
            "p90_of_native_cell_daily_maxima",
            "nearest_suitable_native_cell"
          ]
        },
        "source_cells": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "native_uvi_range": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "native_uvi_median": {
          "type": "number",
          "minimum": 0
        },
        "quality_flag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "peak_window_start_range_utc": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date-time"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "peak_window_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "source_point": {
          "type": "object",
          "required": [
            "latitude",
            "longitude",
            "altitude_m",
            "cell",
            "altitude_difference_m"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "altitude_m": {
              "type": "number"
            },
            "altitude_difference_m": {
              "type": "number",
              "minimum": -300,
              "maximum": 300
            },
            "cell": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "uvi": {
                "type": "null"
              },
              "display_uvi": {
                "type": "null"
              },
              "category": {
                "type": "null"
              },
              "reasons": {
                "minItems": 1
              }
            }
          },
          "else": {
            "required": [
              "aggregation",
              "source_cells",
              "native_uvi_range",
              "native_uvi_median",
              "quality_flag",
              "peak_window_start_range_utc"
            ],
            "properties": {
              "uvi": {
                "type": "number",
                "minimum": 0
              },
              "display_uvi": {
                "type": "integer",
                "minimum": 0
              },
              "category": {
                "type": "string"
              },
              "valid_cells": {
                "minimum": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "location": {
                      "properties": {
                        "kind": {
                          "const": "town"
                        }
                      }
                    }
                  }
                },
                "then": {
                  "required": [
                    "source_point",
                    "peak_window_start_utc"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "degraded"
              }
            }
          },
          "then": {
            "properties": {
              "reasons": {
                "minItems": 1,
                "contains": {
                  "const": "partial_spatial_support"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "low"
              }
            }
          },
          "then": {
            "properties": {
              "display_uvi": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "moderate"
              }
            }
          },
          "then": {
            "properties": {
              "display_uvi": {
                "type": "integer",
                "minimum": 3,
                "maximum": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "high"
              }
            }
          },
          "then": {
            "properties": {
              "display_uvi": {
                "type": "integer",
                "minimum": 6,
                "maximum": 7
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "very_high"
              }
            }
          },
          "then": {
            "properties": {
              "display_uvi": {
                "type": "integer",
                "minimum": 8,
                "maximum": 10
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "extreme"
              }
            }
          },
          "then": {
            "properties": {
              "display_uvi": {
                "type": "integer",
                "minimum": 11
              }
            }
          }
        }
      ]
    }
  }
}
